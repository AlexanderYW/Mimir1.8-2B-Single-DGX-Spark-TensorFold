# Copy to .env and uncomment what you change. The environment wins over .env; scripts/config.sh documents every setting.

# Export (scripts/prepare.sh makes it from the BF16 release)
# FORMAT=nvfp4              # nvfp4 (the stacks' projections, ModelOpt layout, W4A16) or bf16 (as released)
# HEAD_FORMAT=bf16          # bf16 or nvfp4: lm_head too
# WINDOW=8192               # the export's max_position_embeddings (the release names 4096; its evaluation serves 8192)
# EXPORT_DEVICE=cpu         # cpu or cuda

# Serving
# PORT=8890
# PARALLEL=4
# CONTEXT=8192              # at most WINDOW
# MAX_TOKENS=2048
# DRAFTS=1                  # context-copy drafts; 0 passes --no-drafts
# TEMPERATURE=0             # greedy, as the release's evaluations decode
# SERVED_NAME=mimir-1.8

# Memory
# TENSORFOLD_MEMORY_RESERVE_GIB=8

# Access
# TENSORFOLD_API_KEY=...    # require this bearer token on every request
# HF_TOKEN=hf_...           # only for gated or private repos; the default is public

# Paths
# HF_CACHE=/data/huggingface
# EXPORT_ROOT=/data/huggingface/tensorfold-models
