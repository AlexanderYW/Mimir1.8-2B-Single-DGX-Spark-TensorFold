+extern "C" __global__ void __launch_bounds__(128)
+    tf_hrm_attn_merge_gate(const AttnSegs sg, const float* __restrict__ PO, const float* __restrict__ PM,
+                           const float* __restrict__ PL, const __nv_bfloat16* __restrict__ GQKV,
