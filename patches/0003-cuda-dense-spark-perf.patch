+        const bool active = cl > 0.0f;
+        const float next = active ? fmaxf(m, cm) : m;
+        const float a = active ? (m == -INFINITY ? 0.0f : tf_exp(__fsub_rn(m, next))) : 1.0f;
+        const float b = active ? tf_exp(__fsub_rn(cm, next)) : 0.0f;
