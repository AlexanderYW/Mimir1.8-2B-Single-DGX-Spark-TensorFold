+        den = __fmaf_rn(den, a, __fmul_rn(cl, b));
+        m = next;
+    }
+    const float y_bf = bfr(__fdiv_rn(o, den));
+    const int64_t row = static_cast<int64_t>(row_off) + rq;
+    const int64_t D = static_cast<int64_t>(H) * HD;
+    const float g = bf(GQKV[row * 4 * D + head * HD + d]);
+    const float sg_val = bfr(__frcp_rn(__fadd_rn(1.0f, expf(-g))));
+    OUT[row * D + head * HD + d] = __float2bfloat16_rn(__fmul_rn(sg_val, y_bf));
+}
