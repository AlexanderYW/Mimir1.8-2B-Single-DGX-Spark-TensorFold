+}
diff --git a/zig/src/families/hrm_text/cuda_kernels.zig b/zig/src/families/hrm_text/cuda_kernels.zig
new file mode 100644
index 0000000..c365d18
--- /dev/null
+++ b/zig/src/families/hrm_text/cuda_kernels.zig
@@ -0,0 +1,102 @@
+//! HRM-Text's own CUDA launches beside the dense engine's (hrm_text.cu): scaled embedding rows, the states between
+//! stack calls, gate|q|k|v with RoPE, and the attention output gate.
+const std = @import("std");
+const cuda = @import("cuda");
+
+/// Threads a row kernel's block takes, one column each.
+const row_threads = 256;
+/// Threads a (row, head) RoPE block takes: dims j and j + 64 of a 128-dim head.
+const rope_threads = 64;
+
+fn int(x: usize) c_int {
+    return @intCast(x);
+}
+
+/// A row kernel's grid (rows, ceil(width / 256)), null when empty; past an int's range refused.
+fn rowGrid(rows: usize, width: usize) !?cuda.launch.Dim3 {
+    if (rows == 0 or width == 0) return null;
+    if (rows > std.math.maxInt(c_int) or width > std.math.maxInt(c_int)) return error.RowShape;
+    return .{ .x = @intCast(rows), .y = @intCast((width + row_threads - 1) / row_threads), .z = 1 };
+}
+
+pub const Kernels = struct {
+    mod: cuda.Module,
+    embed_fn: cuda.Function,
+    start_fn: cuda.Function,
+    turn_fn: cuda.Function,
+    rope_fn: cuda.Function,
+    gate_fn: cuda.Function,
+
+    pub fn load(ctx: *const cuda.Context) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(ctx.d, cuda.kernels.hrm_text);
+        errdefer mod.unload();
+        return .{
+            .mod = mod,
+            .embed_fn = try mod.function("tf_hrm_embed"),
+            .start_fn = try mod.function("tf_hrm_start"),
+            .turn_fn = try mod.function("tf_hrm_turn"),
+            .rope_fn = try mod.function("tf_hrm_gqkv_rope"),
+            .gate_fn = try mod.function("tf_hrm_gate"),
+        };
+    }
+
+    pub fn deinit(k: *Kernels) void {
+        k.mod.unload();
+    }
+
+    /// h [rows, d] = bf16(table[ids[row]] * scale).
+    pub fn embed(k: *const Kernels, s: cuda.Stream, ids: u64, table: u64, h: u64, rows: usize, d: usize, scale: f32) !void {
+        const grid = try rowGrid(rows, d) orelse return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ ids, table, h }) |v| a.add(v);
+        a.add(int(d));
+        a.add(scale);
+        try cuda.launch.launch(k.embed_fn, .{ .grid = grid, .block = .{ .x = row_threads } }, s, &a);
+    }
+
+    /// z_high = h; h = bf16(z_init + h): the first stack call's input.
+    pub fn start(k: *const Kernels, s: cuda.Stream, h: u64, z_high: u64, z_init: u64, rows: usize, d: usize) !void {
+        const grid = try rowGrid(rows, d) orelse return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ h, z_high, z_init }) |v| a.add(v);
+        a.add(int(d));
+        try cuda.launch.launch(k.start_fn, .{ .grid = grid, .block = .{ .x = row_threads } }, s, &a);
+    }
+
+    /// keep = x (a stack call's final norm); h = bf16(x + other): the next call's input.
+    pub fn turn(k: *const Kernels, s: cuda.Stream, x: u64, keep: u64, other: u64, h: u64, rows: usize, d: usize) !void {
+        const grid = try rowGrid(rows, d) orelse return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ x, keep, other, h }) |v| a.add(v);
+        a.add(int(d));
+        try cuda.launch.launch(k.turn_fn, .{ .grid = grid, .block = .{ .x = row_threads } }, s, &a);
+    }
+
+    /// From gqkv [rows, 4 heads x 128] bf16: gate heads to g, q rotated to q, k rotated and v to kv [rows, k | v].
+    pub fn gqkvRope(k: *const Kernels, s: cuda.Stream, gqkv: u64, inv: u64, pos: u64, g: u64, q: u64, kv: u64, rows: usize, heads: usize) !void {
+        if (rows == 0) return;
+        if (rows > std.math.maxInt(c_int) or 4 * heads > 65535) return error.RowShape;
+        var a: cuda.Args = .{};
+        for ([_]u64{ gqkv, inv, pos, g, q, kv }) |v| a.add(v);
+        a.add(int(heads));
+        try cuda.launch.launch(k.rope_fn, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(4 * heads), .z = 1 }, .block = .{ .x = rope_threads } }, s, &a);
+    }
+
+    /// y = bf16(bf16(sigmoid(g)) * y) in place, both [rows, d].
+    pub fn gate(k: *const Kernels, s: cuda.Stream, g: u64, y: u64, rows: usize, d: usize) !void {
+        const grid = try rowGrid(rows, d) orelse return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ g, y }) |v| a.add(v);
+        a.add(int(d));
+        try cuda.launch.launch(k.gate_fn, .{ .grid = grid, .block = .{ .x = row_threads } }, s, &a);
+    }
+};
+
+test "HRM-Text row grids: every row and column covered, empty calls launch nothing, oversize refused" {
+    try std.testing.expectEqual(@as(?cuda.launch.Dim3, null), try rowGrid(0, 1536));
+    const g = (try rowGrid(8192, 1536)).?;
+    try std.testing.expect(g.x == 8192 and g.y == 6 and g.z == 1);
+    try std.testing.expectEqual(@as(c_uint, 7), (try rowGrid(1, 1537)).?.y);
+    try std.testing.expectError(error.RowShape, rowGrid(@as(usize, std.math.maxInt(c_int)) + 1, 1));
+}
diff --git a/zig/src/families/hrm_text/cuda_recipe.zig b/zig/src/families/hrm_text/cuda_recipe.zig
new file mode 100644
index 0000000..7d6df05
--- /dev/null
+++ b/zig/src/families/hrm_text/cuda_recipe.zig
@@ -0,0 +1,152 @@
+//! HRM-Text as a cuda_dense recipe: the engine's layer i is stack call i / per_stack's layer i % per_stack, with its
+//! own cache slot i, so a token's 128 layer applications page like a 128-layer decoder's.
+//!
+//! Scratch use per layer (pass.zig's buffers): x.wide holds gate|q|k|v, then gate|up; x.acc's bytes hold the bf16
+//! attention gate across the attention; x.y the attention out, then the SwiGLU rows. The recurrent states z_L and
+//! z_H live in the weights' own row buffers.
+const std = @import("std");
+const cuda = @import("cuda");
+const dense = @import("cuda_dense");
+const cfg = @import("config.zig");
+const wts = @import("cuda_weights.zig");
+const kern = @import("cuda_kernels.zig");
+
+const Recipe = @This();
+const P = *const dense.Pass(Recipe);
+
+pub const name = "HRM-Text";
+pub const model_type = "hrm_text";
+pub const formats: []const []const u8 = &.{ "bf16", "modelopt-nvfp4" };
+/// The window the model card evaluates at (its vLLM run overrides max_position_embeddings to 8192, plain RoPE).
+pub const default_context: i64 = 8192;
+/// Thinking is off in the release's chat template: replies are content.
+pub const reasoning = false;
+/// A PrefixLM prompt runs whole: the engine's prompt chunk is the longest window served.
+pub const prompt_rows: u32 = cfg.max_context;
+
+pub const Weights = wts.Weights;
+pub const Kernels = kern.Kernels;
+
+/// The engine's geometry of an admitted HRM-Text config: a layer per stack call's layer, multi-head attention.
+pub fn geometryOf(c: cfg.Config) dense.Geometry {
+    const h: usize = c.hidden;
+    return .{
+        .hidden = h,
+        .layers = c.slots(),
+        .heads = c.heads,
+        .kv_heads = c.heads,
+        .head_dim = cfg.head_dim,
+        .vocab = c.vocab,
+        .eps = c.eps,
+        .context = c.context,
+        .acc = 4 * c.width(), // gate|q|k|v
+        .wide = 2 * c.intermediate, // gate|up
+        .mid = c.intermediate,
+        .theta = c.theta, // HF's float32 inv_freq at theta 1e4, head 128 matches rope.inverse bit for bit
+        .prefix_lm = c.prefix_lm,
+        .prompt_rows = prompt_rows,
+    };
+}
+
+/// config.json admitted as HRM-Text's, before any tensor is read.
+pub fn geometry(a: std.mem.Allocator, io: std.Io, dir: []const u8) !dense.Geometry {
+    return geometryOf(try cfg.Config.read(a, io, dir));
+}
+
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: cuda.Stream, dir: []const u8) !Weights {
+    return wts.load(gpa, io, d, s, dir, prompt_rows);
+}
+
+/// The weights' and states' bytes on the device, every projection's format read from its header.
+pub fn weightBytes(a: std.mem.Allocator, io: std.Io, dir: []const u8) !u64 {
+    return wts.bytesOf(a, io, dir, prompt_rows);
+}
+
+/// z_H's first value: the embedding rows times embedding_scale.
+pub fn embed(p: P) !void {
+    try p.own.embed(p.s, p.m.s.ids, p.w.embed, p.m.s.h, p.rows, p.g.hidden, p.w.config.embed_scale);
+}
+
+/// Layer application i. At a stack call's first layer the previous call ends (its last residual and its final
+/// norm, kept as the state it updates) and the call's input is formed: z_L_init + z_H for the first, else the new
+/// state plus the other one. Then one layer: weightless RMS, gate|q|k|v, RoPE, attention over slot i, sigmoid gate,
+/// o, weightless RMS, SwiGLU.
+pub fn layer(p: P, i: usize) !void {
+    const x = p.m.s;
+    const c = p.w.config;
+    const call = i / c.per_stack;
+    const j = i % c.per_stack;
+    const d = p.g.hidden;
+    if (j == 0) {
+        if (call == 0) {
+            try p.own.start(p.s, x.h, p.w.z_high, p.w.z_init, p.rows, d);
+        } else {
+            try p.norm(x.r, p.w.ones); // h + the last MLP's rows, then the stack's final norm into x
+            const high = c.isHigh(call - 1);
+            try p.own.turn(p.s, x.x, if (high) p.w.z_high else p.w.z_low, if (high) p.w.z_low else p.w.z_high, x.h, p.rows, d);
+        }
+        try p.norm(null, p.w.ones);
+    } else try p.norm(x.r, p.w.ones);
+    const l = p.w.layer(if (c.isHigh(call)) .high else .low, j);
+    try p.project(l.gqkv, x.x, x.wide);
+    try tapped(p, "gqkv", i, x.x, d, x.wide, p.g.acc);
+    try p.own.gqkvRope(p.s, x.wide, p.m.inv, x.pos, x.acc, x.q, x.kv, p.rows, c.heads);
+    try p.attend(i, x.q, x.kv, x.y);
+    try p.own.gate(p.s, x.acc, x.y, p.rows, c.width());
+    try p.project(l.o, x.y, x.r);
+    try tapped(p, "o", i, x.y, c.width(), x.r, d);
+    try p.norm(x.r, p.w.ones);
+    try p.project(l.gate_up, x.x, x.wide);
+    try p.siluMul(x.wide, x.y, p.g.mid);
+    try p.project(l.down, x.y, x.r);
+    try tapped(p, "down", i, x.y, p.g.mid, x.r, d);
+}
+
+/// A projection's input [rows, k] and output [rows, n] as `<class>.<layer>.x` and `.y`, when a check taps the pass.
+fn tapped(p: P, class: []const u8, i: usize, in: u64, k: usize, y: u64, n: usize) !void {
+    if (p.taps == null) return;
+    var stage: [32]u8 = undefined;
+    try p.tap(try std.fmt.bufPrint(&stage, "{s}.{d}.x", .{ class, i }), in, k);
+    try p.tap(try std.fmt.bufPrint(&stage, "{s}.{d}.y", .{ class, i }), y, n);
+}
+
+/// The last H call ends: its last residual and its final norm, z_H, the head's input rows.
+pub fn final(p: P) !void {
+    try p.norm(p.m.s.r, p.w.ones);
+}
+
+pub fn head(w: *const Weights) cuda.qmmf.Weight {
+    return w.head;
+}
+
+pub fn explain(err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.BadHrmConfig => "this checkpoint's config is not HRM-Text's (model_type hrm_text, HrmTextForCausalLM)",
+        error.UnsupportedHrmGeometry => "this HRM-Text checkpoint's geometry is not one the CUDA recipe serves: head dim 128, multi-head attention, SiLU SwiGLU without biases, an untied head, at most 16 stack calls of at most 32 layers",
+        error.UnsupportedHrmRotary => "this HRM-Text checkpoint's rope is not the default 1-D rope the recipe applies",
+        error.UnsupportedHrmPrecision => "this HRM-Text checkpoint is quantized another way: the recipe reads BF16 or a ModelOpt NVFP4 export (weights only, blocks of 16)",
+        error.HrmPastPromptRows => std.fmt.comptimePrint("this HRM-Text checkpoint names a window past {d} tokens: a PrefixLM prompt runs whole in one {d}-row chunk", .{ prompt_rows, prompt_rows }),
+        error.HrmShape, error.HrmTensorCount => "this HRM-Text checkpoint's tensors are not the release's (BF16) or its NVFP4 export's: download or export it again",
+        else => null,
+    };
+}
+
+test "Mimir v1.8's geometry: 128 layer slots of 12 heads x 128, PrefixLM prompts of up to 8192 rows" {
+    const c = try cfg.parse(std.testing.allocator, @embedFile("fixtures/config.json"));
+    const g = geometryOf(c);
+    try std.testing.expectEqual(dense.Geometry{ .hidden = 1536, .layers = 128, .heads = 12, .kv_heads = 12, .head_dim = 128, .vocab = 262144, .eps = 1e-6, .context = 4096, .acc = 6144, .wide = 8192, .mid = 4096, .theta = 1e4, .prefix_lm = true, .prompt_rows = 8192 }, g);
+    const shape = try dense.recipe.attentionShape(g);
+    try std.testing.expect(shape.hpc == 1 and shape.grid_y == 12 and shape.rows == 128);
+    try std.testing.expect(std.mem.indexOf(u8, shape.pattn, "pattn_prefix_kernel") != null);
+    // a token's keys and values over 128 slots: 768 KiB; a 512-row page 384 MiB
+    try std.testing.expectEqual(@as(u64, 128 * 2 * 512 * 1536 * 2), dense.pages.pageBytes(g));
+}
+
+test "HRM-Text rope: the engine's float32 inverse frequencies are Transformers' at theta 1e4, head dim 128" {
+    var mine: [64]f32 = undefined;
+    dense.rope.inverse(1e4, 128, &mine);
+    // torch: 1.0 / (10000.0 ** (torch.arange(0, 128, 2, dtype=torch.float) / 128)), bits as fixtures/rope_inv_freq.txt
+    const text = @embedFile("fixtures/rope_inv_freq.txt");
+    var it = std.mem.tokenizeAny(u8, text, ", \n");
+    for (mine) |v| try std.testing.expectEqual(try std.fmt.parseInt(u32, it.next().?, 0), @as(u32, @bitCast(v)));
+}
diff --git a/zig/src/families/hrm_text/cuda_weights.zig b/zig/src/families/hrm_text/cuda_weights.zig
new file mode 100644
index 0000000..57ee02b
--- /dev/null
+++ b/zig/src/families/hrm_text/cuda_weights.zig
@@ -0,0 +1,206 @@
+//! HRM-Text on CUDA: the two stacks' projections as stored (BF16, or a ModelOpt NVFP4 export's), packed for the
+//! lane matmul; the bf16 embedding, z_L_init, the head; the recurrent states z_L and z_H a prompt chunk wide.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const cfg = @import("config.zig");
+
+const DeviceBuffer = cuda.DeviceBuffer;
+const Weight = cuda.qmmf.Weight;
+
+pub const Stack = enum { low, high };
+const stack_names = [_][]const u8{ "model.L_module", "model.H_module" };
+
+/// One stack layer as the checkpoint fuses it: gqkv is gate|q|k|v [4 width, hidden], gate_up is gate|up.
+pub const Layer = struct {
+    gqkv: Weight,
+    o: Weight,
+    gate_up: Weight,
+    down: Weight,
+};
+
+pub const Weights = struct {
+    gpa: std.mem.Allocator,
+    config: cfg.Config,
+    buffers: std.ArrayList(DeviceBuffer) = .empty,
+    /// [stack][layer]: the L module's layers, then the H module's.
+    layers: [2][]Layer = .{ &.{}, &.{} },
+    embed: u64 = 0, // bf16 [vocab, hidden]
+    z_init: u64 = 0, // bf16 [hidden]: z_L_init, every row's first low state
+    ones: u64 = 0, // bf16 [hidden] of 1.0: HrmTextRMSNorm has no weight, the engine's norm multiplies by these
+    head: Weight = undefined, // the untied lm_head
+    /// bf16 [rows, hidden] a prompt chunk's: the low and high states between stack calls.
+    z_low: u64 = 0,
+    z_high: u64 = 0,
+    /// Projections stored NVFP4 (counted at load, for the startup line).
+    packed4: usize = 0,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.buffers.items) |*b| b.free();
+        w.buffers.deinit(w.gpa);
+        for (w.layers) |l| w.gpa.free(l);
+    }
+
+    fn alloc(w: *Weights, d: *const cuda.Driver, bytes: usize) !DeviceBuffer {
+        try w.buffers.ensureUnusedCapacity(w.gpa, 1);
+        const b = try DeviceBuffer.alloc(d, @max(bytes, 256));
+        w.buffers.appendAssumeCapacity(b);
+        return b;
+    }
+
+    pub fn layer(w: *const Weights, stack: Stack, i: usize) *const Layer {
+        return &w.layers[@backingInt(stack)][i];
+    }
+};
+
+/// A projection's shape: its rows (outputs) and inputs.
+const Shape = struct { n: usize, k: usize };
+
+fn shapes(c: cfg.Config) [4]Shape {
+    const h = c.hidden;
+    return .{ .{ .n = 4 * c.width(), .k = h }, .{ .n = h, .k = c.width() }, .{ .n = 2 * c.intermediate, .k = h }, .{ .n = h, .k = c.intermediate } };
+}
+const parts = [_][]const u8{ "attn.gqkv_proj", "attn.o_proj", "mlp.gate_up_proj", "mlp.down_proj" };
+
+/// A projection's device bytes: NVFP4 words and scale tiles over padded rows, or padded bf16 rows.
+fn projBytes(s: Shape, nvfp4: bool) u64 {
+    const npad = cuda.modelopt.padded(s.n);
+    return if (nvfp4) npad * s.k / 2 + npad * s.k / 16 else npad * s.k * 2;
+}
+
+/// The device bytes `load` allocates for `c`, with `prompt_rows` rows of states: what the host admits before it.
+pub fn deviceBytes(c: cfg.Config, prompt_rows: usize, head_nvfp4: bool) u64 {
+    var total: u64 = 0;
+    for (shapes(c)) |s| total += 2 * c.per_stack * projBytes(s, c.nvfp4);
+    total += c.vocab * c.hidden * 2; // the embedding, as stored
+    total += projBytes(.{ .n = c.vocab, .k = c.hidden }, head_nvfp4);
+    total += 2 * c.hidden * 2; // z_L_init and the ones
+    total += 2 * prompt_rows * c.hidden * 2; // z_L and z_H
+    return total;
+}
+
+/// Reads the checkpoint into the device on `s`, packing each projection for the lane.
+const Loader = struct {
+    w: *Weights,
+    ck: *core.Checkpoint,
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+    pack: *const cuda.modelopt.Packer,
+    stage: DeviceBuffer,
+
+    /// A bf16 tensor as stored, in a buffer of its own.
+    fn raw(l: *Loader, name: []const u8, shape: []const usize) !u64 {
+        const t = try l.ck.expect(name, .bf16, shape);
+        const b = try l.w.alloc(l.d, t.bytes.len);
+        try b.upload(0, t.bytes);
+        return b.ptr;
+    }
+
+    /// `{base}.weight` packed for the lane: NVFP4 when stored as ModelOpt's codes (with weight_scale and
+    /// weight_scale_2), else bf16. A stored input_scale is left unread: the lane takes bf16 rows (W4A16).
+    fn proj(l: *Loader, base: []const u8, s: Shape) !Weight {
+        var buf: [3][160]u8 = undefined;
+        const wname = try std.fmt.bufPrint(&buf[0], "{s}.weight", .{base});
+        const t = try l.ck.get(wname);
+        if (t.dtype == .u8) {
+            if (s.k % 64 != 0) return error.HrmShape;
+            const codes = try l.ck.expect(wname, .u8, &.{ s.n, s.k / 2 });
+            const blocks = try l.ck.expect(try std.fmt.bufPrint(&buf[1], "{s}.weight_scale", .{base}), .f8_e4m3, &.{ s.n, s.k / 16 });
+            const g = try l.ck.get(try std.fmt.bufPrint(&buf[2], "{s}.weight_scale_2", .{base}));
+            if (g.dtype != .f32 or g.bytes.len != 4) return error.HrmShape;
+            const global: f32 = @bitCast(std.mem.readInt(u32, g.bytes[0..4], .little));
+            if (!(global > 0) or !std.math.isFinite(global)) return error.HrmShape;
+            const input = try std.fmt.bufPrint(&buf[1], "{s}.input_scale", .{base});
+            if (l.ck.has(input)) try l.ck.skip(input);
+            try l.stage.upload(0, codes.bytes);
+            try l.stage.upload(codes.bytes.len, blocks.bytes);
+            const npad = cuda.modelopt.padded(s.n);
+            const words = try l.w.alloc(l.d, npad * s.k / 2);
+            const tiles = try l.w.alloc(l.d, npad * s.k / 16);
+            try l.pack.fp4Lane(l.s, l.stage.ptr, l.stage.ptr + codes.bytes.len, words.ptr, tiles.ptr, s.n, s.k);
+            try l.s.synchronize(); // the next projection's upload reuses the stage
+            l.w.packed4 += 1;
+            return cuda.nvfp4.weight(words.ptr, tiles.ptr, global, s.n, s.k);
+        }
+        const b16 = try l.ck.expect(wname, .bf16, &.{ s.n, s.k });
+        try l.stage.upload(0, b16.bytes);
+        const b = try l.w.alloc(l.d, cuda.modelopt.padded(s.n) * s.k * 2);
+        try l.pack.bf16Lane(l.s, l.stage.ptr, b.ptr, s.n, s.k);
+        try l.s.synchronize();
+        return cuda.modelopt.bf16Weight(b.ptr, s.n, s.k);
+    }
+
+    /// A failed load's work proved complete (the packing stream, then the uploads' null stream) before buffers go.
+    fn settle(l: *const Loader) void {
+        cuda.completion.drain(l.d, l.s, "an HRM-Text weight load did not drain before its buffers were freed");
+        cuda.completion.drain(l.d, .{ .d = l.d, .handle = null }, "HRM-Text weight uploads did not drain before their buffers were freed");
+    }
+};
+
+/// The HRM-Text checkpoint at `dir`; `prompt_rows` rows of states. A tensor left over refuses.
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: cuda.Stream, dir: []const u8, prompt_rows: usize) !Weights {
+    const c = try cfg.Config.read(gpa, io, dir);
+    var ck = try core.Checkpoint.openModel(gpa, io, dir);
+    defer ck.close();
+    var pack = try cuda.modelopt.Packer.load(d);
+    defer pack.unload();
+    var w: Weights = .{ .gpa = gpa, .config = c };
+    errdefer w.deinit();
+    for (&w.layers) |*l| {
+        l.* = try gpa.alloc(Layer, c.per_stack);
+    }
+    const h: usize = c.hidden;
+    // the stage holds the largest tensor as stored: the bf16 head (or its codes and scales)
+    var stage = try DeviceBuffer.alloc(d, @as(usize, c.vocab) * h * 2);
+    defer stage.free();
+    var l: Loader = .{ .w = &w, .ck = &ck, .d = d, .s = s, .pack = &pack, .stage = stage };
+    errdefer l.settle(); // runs first on failure: the stage, the weights and the packer go after it
+    w.embed = try l.raw("model.embed_tokens.weight", &.{ c.vocab, h });
+    w.z_init = try l.raw("model.z_L_init", &.{h});
+    w.head = try l.proj("lm_head", .{ .n = c.vocab, .k = h });
+    const sh = shapes(c);
+    var name: [128]u8 = undefined;
+    for (stack_names, 0..) |stack, si| for (w.layers[si], 0..) |*y, i| {
+        var got: [4]Weight = undefined;
+        for (parts, sh, &got) |part, shape, *out|
+            out.* = try l.proj(try std.fmt.bufPrint(&name, "{s}.layers.{d}.{s}", .{ stack, i, part }), shape);
+        y.* = .{ .gqkv = got[0], .o = got[1], .gate_up = got[2], .down = got[3] };
+    };
+    if (ck.unused() != 0) return error.HrmTensorCount;
+    // the weightless norms' multiplier, and the states a prompt chunk wide
+    const ones = try gpa.alloc(u16, h);
+    defer gpa.free(ones);
+    @memset(ones, 0x3F80); // bf16 1.0
+    const ob = try w.alloc(d, h * 2);
+    try ob.upload(0, std.mem.sliceAsBytes(ones));
+    w.ones = ob.ptr;
+    w.z_low = (try w.alloc(d, prompt_rows * h * 2)).ptr;
+    w.z_high = (try w.alloc(d, prompt_rows * h * 2)).ptr;
+    try s.synchronize();
+    std.log.info("HRM-Text: {d} x {d} layers ({d} calls, {d} cache slots), {d} projections NVFP4, the rest bf16", .{ 2, c.per_stack, c.calls(), c.slots(), w.packed4 });
+    return w;
+}
+
+/// The checkpoint's device bytes, every header read for the head's and the layers' formats.
+pub fn bytesOf(a: std.mem.Allocator, io: std.Io, dir: []const u8, prompt_rows: usize) !u64 {
+    var c = try cfg.Config.read(a, io, dir);
+    var ck = try core.Checkpoint.openModel(a, io, dir);
+    defer ck.close();
+    const head = try ck.get("lm_head.weight");
+    const layer = try ck.get("model.L_module.layers.0.attn.gqkv_proj.weight");
+    c.nvfp4 = layer.dtype == .u8;
+    return deviceBytes(c, prompt_rows, head.dtype == .u8);
+}
+
+test "HRM-Text device bytes: Mimir v1.8 in bf16 and as the NVFP4 export with a bf16 head" {
+    const c = try cfg.parse(std.testing.allocator, @embedFile("fixtures/config.json"));
+    // per layer bf16: (6144 + 1536 + 8192) x 1536 + 1536 x 4096 = 30.7M values; 32 layers
+    const layer_bf16: u64 = (6144 * 1536 + 1536 * 1536 + 8192 * 1536 + 1536 * 4096) * 2;
+    const table: u64 = 262144 * 1536 * 2;
+    const tail: u64 = 2 * 1536 * 2 + 2 * 8192 * 1536 * 2;
+    try std.testing.expectEqual(32 * layer_bf16 + 2 * table + tail, deviceBytes(c, 8192, false));
+    var q = c;
+    q.nvfp4 = true;
+    const layer4: u64 = (6144 * 1536 + 1536 * 1536 + 8192 * 1536 + 1536 * 4096) * 9 / 16; // codes + e4m3 a 16
+    try std.testing.expectEqual(32 * layer4 + 2 * table + tail, deviceBytes(q, 8192, false));
+}
