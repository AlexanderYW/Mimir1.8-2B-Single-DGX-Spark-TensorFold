+++ b/zig/build/hrm_text_cuda.zig
@@ -0,0 +1,12 @@
+//! HRM-Text's CUDA family (DFM-Mimir v1.8) over the runtime, the core, the lane core and the dense engine; its host tests.
+const std = @import("std");
+
+pub fn module(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, cuda: *std.Build.Module, core: *std.Build.Module, lanes: *std.Build.Module, dense: *std.Build.Module) *std.Build.Module {
+    return b.createModule(.{ .root_source_file = b.path("zig/src/families/hrm_text/cuda.zig"), .target = target, .optimize = optimize, .link_libc = true, .imports = &.{ .{ .name = "cuda", .module = cuda }, .{ .name = "core", .module = core }, .{ .name = "lanes", .module = lanes }, .{ .name = "cuda_dense", .module = dense } } });
+}
+
+pub fn host(b: *std.Build, m: *std.Build.Module, all: *std.Build.Step) void {
+    const run = b.addRunArtifact(b.addTest(.{ .root_module = m }));
+    b.step("test-hrm-text-cuda-host", "HRM-Text on CUDA: config, geometry, device bytes, Native decls and refusals without a GPU").dependOn(&run.step);
+    all.dependOn(&run.step);
+}
diff --git a/zig/kernels/cuda/hrm_text.cu b/zig/kernels/cuda/hrm_text.cu
new file mode 100644
index 0000000..c47e617
--- /dev/null
+++ b/zig/kernels/cuda/hrm_text.cu
@@ -0,0 +1,94 @@
+// HRM-Text's CUDA glue (DFM-Mimir v1.8) beside the dense engine's launches, at Transformers' BF16 rounding points:
+// the scaled embedding rows, the recurrent states between stack calls, gate|q|k|v with RoPE, the output gate.
+
+#include <cuda_bf16.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace tf_hrm {
+constexpr int HD = 128, HALF = HD / 2;
+
+__device__ __forceinline__ float bf(__nv_bfloat16 v) { return __bfloat162float(v); }
+__device__ __forceinline__ float bfr(float v) { return __bfloat162float(__float2bfloat16_rn(v)); }
+}  // namespace tf_hrm
+
+using tf_hrm::bf;
+using tf_hrm::bfr;
+
+// Grid (rows, ceil(D / 256)), 256 threads: H [rows][D] = bf16(E[ids[row]] * scale), inputs_embeds * embedding_scale
+// (a bf16 tensor times a Python float: fp32 opmath, one rounding).
+extern "C" __global__ void __launch_bounds__(256)
+    tf_hrm_embed(const int* __restrict__ IDS, const __nv_bfloat16* __restrict__ E, __nv_bfloat16* __restrict__ H, int D,
+                 float scale) {
+    const int64_t r = blockIdx.x;
+    const int c = blockIdx.y * 256 + threadIdx.x;
+    if (c >= D) return;
+    const int64_t id = IDS[r];
+    H[r * D + c] = __float2bfloat16_rn(__fmul_rn(bf(E[id * D + c]), scale));
+}
+
+// Grid (rows, ceil(D / 256)), 256 threads: the first stack call's input. ZH = H (z_H, the scaled embedding),
+// H = bf16(Z0[col] + H): z_L_init.expand_as(z_H) + z_H.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_hrm_start(__nv_bfloat16* __restrict__ H, __nv_bfloat16* __restrict__ ZH, const __nv_bfloat16* __restrict__ Z0, int D) {
+    const int64_t at = (int64_t)blockIdx.x * D + blockIdx.y * 256 + threadIdx.x;
+    const int c = blockIdx.y * 256 + threadIdx.x;
+    if (c >= D) return;
+    const __nv_bfloat16 h = H[at];
+    ZH[at] = h;
+    H[at] = __float2bfloat16_rn(__fadd_rn(bf(Z0[c]), bf(h)));
+}
+
+// Grid (rows, ceil(D / 256)), 256 threads: a stack call ended with its final norm in X. KEEP = X (the state it
+// updates), H = bf16(X + OTHER): the next call's input is always the new state plus the other one
+// (L after L: z_L + z_H; H after L: z_H + z_L; L after H: z_L + z_H), and a bf16 sum is the same either way round.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_hrm_turn(const __nv_bfloat16* __restrict__ X, __nv_bfloat16* __restrict__ KEEP, const __nv_bfloat16* __restrict__ OTHER,
+                __nv_bfloat16* __restrict__ H, int D) {
+    const int c = blockIdx.y * 256 + threadIdx.x;
+    if (c >= D) return;
+    const int64_t at = (int64_t)blockIdx.x * D + c;
+    const __nv_bfloat16 x = X[at];
+    KEEP[at] = x;
+    H[at] = __float2bfloat16_rn(__fadd_rn(bf(x), bf(OTHER[at])));
+}
+
+// Grid (rows, 4 NH), 64 threads: thread j takes dims j and j + 64 of head h of the fused projection's bf16 row
+// GQKV [rows][gate NH | q NH | k NH | v NH] x 128. The gate heads go to G [rows][NH x 128], q rotated to
+// Q [rows][NH x 128], k rotated and v to KV [rows][k NH | v NH] x 128 (tf_nemo_kv_write_segs' rows).
+// HF: cos and sin are fp32 cos/sin of the fp32 angle pos x inv_freq, cast to bf16; q * cos and
+// rotate_half(q) * sin each round to bf16, and so does their sum.
+extern "C" __global__ void __launch_bounds__(64)
+    tf_hrm_gqkv_rope(const __nv_bfloat16* __restrict__ GQKV, const float* __restrict__ INV, const int* __restrict__ POS,
+                     __nv_bfloat16* __restrict__ G, __nv_bfloat16* __restrict__ Q, __nv_bfloat16* __restrict__ KV, int NH) {
+    using tf_hrm::HALF;
+    using tf_hrm::HD;
+    const int r = blockIdx.x, part = blockIdx.y / NH, h = blockIdx.y % NH, j = threadIdx.x;
+    const __nv_bfloat16* in = GQKV + ((int64_t)r * 4 * NH + blockIdx.y) * HD;
+    __nv_bfloat16* out;
+    if (part == 0) out = G + ((int64_t)r * NH + h) * HD;
+    else if (part == 1) out = Q + ((int64_t)r * NH + h) * HD;
+    else out = KV + ((int64_t)r * 2 * NH + (part - 2) * NH + h) * HD;
+    if (part == 0 || part == 3) {  // gate and v: as projected
+        out[j] = in[j];
+        out[j + HALF] = in[j + HALF];
+        return;
+    }
+    const float a = bf(in[j]), b = bf(in[j + HALF]);
+    const float angle = __fmul_rn(static_cast<float>(POS[r]), INV[j]);
+    const float c = bfr(cosf(angle)), s = bfr(sinf(angle));
+    out[j] = __float2bfloat16_rn(__fadd_rn(bfr(__fmul_rn(a, c)), bfr(__fmul_rn(-b, s))));
+    out[j + HALF] = __float2bfloat16_rn(__fadd_rn(bfr(__fmul_rn(b, c)), bfr(__fmul_rn(a, s))));
+}
+
+// Grid (rows, ceil(D / 256)), 256 threads: Y = bf16(bf16(sigmoid(G)) * Y) in place, torch.sigmoid(gate) * attn
+// on bf16 tensors (each op in fp32, rounded once).
+extern "C" __global__ void __launch_bounds__(256)
+    tf_hrm_gate(const __nv_bfloat16* __restrict__ G, __nv_bfloat16* __restrict__ Y, int D) {
+    const int c = blockIdx.y * 256 + threadIdx.x;
+    if (c >= D) return;
+    const int64_t at = (int64_t)blockIdx.x * D + c;
+    const float g = bf(G[at]);
+    const float sg = bfr(__frcp_rn(__fadd_rn(1.0f, expf(-g))));
+    Y[at] = __float2bfloat16_rn(__fmul_rn(sg, bf(Y[at])));
+}
