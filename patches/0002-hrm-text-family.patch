+//! HRM-Text (DFM-Mimir v1.8) on CUDA: the hrm_text recipe behind the shared dense engine (native/cuda.zig's decls).
+const std = @import("std");
+const dense = @import("cuda_dense");
+
+pub const config = @import("config.zig");
+pub const recipe = @import("cuda_recipe.zig");
+pub const weights = @import("cuda_weights.zig");
+pub const kernels = @import("cuda_kernels.zig");
+pub const native = dense.Native(recipe);
+
+test {
+    _ = config;
+    _ = recipe;
+    _ = weights;
+    _ = kernels;
+}
+
+test "HRM-Text on CUDA: no reasoning block, no prompt states, an 8192-row prompt step, its refusals worded" {
+    try std.testing.expect(!native.reasoning and native.keeps_no_prompts);
+    try std.testing.expectEqual(@as(u32, 8192), native.prompt_rows);
+    try std.testing.expectEqualStrings("hrm_text", native.model_type);
+    // compiles the load and the layer
+    const hooks = .{ &native.open, &native.attach, &native.fits, &native.ledgerPool, &native.textWeightBytes };
+    inline for (hooks) |h| try std.testing.expect(@intFromPtr(h) != 0);
+    for ([_]anyerror{ error.BadHrmConfig, error.UnsupportedHrmGeometry, error.UnsupportedHrmRotary, error.UnsupportedHrmPrecision, error.HrmPastPromptRows, error.HrmShape, error.HrmTensorCount, error.PrefixPastPromptRows, error.UnsupportedDensePrefix }) |e|
+        try std.testing.expect(native.explain(null, e) != null);
+    try std.testing.expectStringStartsWith(native.explain(null, error.PrefixPastPromptRows).?, "HRM-Text is a PrefixLM");
+}
+
+test "HRM-Text on CUDA reads its geometry from the checkpoint's config and refuses another model's by name" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const fixture = @embedFile("fixtures/config.json");
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = fixture });
+    const dir = try std.fmt.allocPrint(a, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer a.free(dir);
+    try std.testing.expectEqual(@as(usize, 128), (try recipe.geometry(a, io, dir)).layers);
+    const other = try std.mem.replaceOwned(u8, a, fixture, "\"hrm_text\"", "\"llama\"");
+    defer a.free(other);
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = other });
