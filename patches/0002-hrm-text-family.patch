diff --git a/zig/src/families/hrm_text/config.zig b/zig/src/families/hrm_text/config.zig
new file mode 100644
index 0000000..39e5205
--- /dev/null
+++ b/zig/src/families/hrm_text/config.zig
@@ -0,0 +1,225 @@
+//! HRM-Text (model_type hrm_text, DFM-Mimir v1.8) admission: two 16-layer stacks run H x (L + 1) times, PrefixLM.
+//!
+//! Transformers' HrmTextModel: z_H = embed(ids) * embedding_scale, z_L = z_L_init. For each of H_cycles high
+//! cycles, L_cycles times z_L = L(z_L + z_H), then z_H = H(z_H + z_L). Each stack is `per_stack` Llama-shaped
+//! layers (weightless RMS norms, multi-head attention with a sigmoid output gate, SwiGLU) and a weightless final
+//! norm; logits are lm_head(z_H). Every stack call keeps its own keys and values: layer slot
+//! (call * per_stack + layer), call = h * (L_cycles + 1) + l, the cache layout HrmTextModel's comment gives.
+const std = @import("std");
+
+pub const head_dim = 128;
+/// Stack calls the forward makes at most (H_cycles * (L_cycles + 1)): the layer slots stay within 256.
+pub const max_calls = 16;
+pub const max_per_stack = 32;
+/// The longest window a PrefixLM prompt runs whole in: the engine's prompt chunk (cuda_recipe.zig's prompt_rows).
+pub const max_context = 8192;
+
+pub const Error = error{
+    BadHrmConfig,
+    UnsupportedHrmGeometry,
+    UnsupportedHrmRotary,
+    UnsupportedHrmPrecision,
+    HrmPastPromptRows,
+} || std.json.ParseError(std.json.Scanner);
+
+pub const Config = struct {
+    hidden: usize,
+    intermediate: usize,
+    /// Layers a stack (transformers' num_layers_per_stack; config.json's num_hidden_layers before post-init).
+    per_stack: usize,
+    h_cycles: usize,
+    l_cycles: usize,
+    heads: usize,
+    vocab: usize,
+    eps: f32,
+    theta: f64,
+    embed_scale: f32,
+    /// The window this checkpoint folder names (max_position_embeddings).
+    context: usize,
+    prefix_lm: bool,
+    /// The folder's ModelOpt NVFP4 export (hf_quant_config.json or quantization_config): the projections packed.
+    nvfp4: bool = false,
+
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Config {
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(bytes);
+        return parse(gpa, bytes);
+    }
+
+    /// Stack calls a forward makes: L_cycles L calls then one H call, H_cycles times.
+    pub fn calls(c: Config) usize {
+        return c.h_cycles * (c.l_cycles + 1);
+    }
+
+    /// Layer applications a token takes, each with its own cache slot: transformers' rewritten num_hidden_layers.
+    pub fn slots(c: Config) usize {
+        return c.calls() * c.per_stack;
+    }
+
+    pub fn width(c: Config) usize {
+        return c.heads * head_dim;
+    }
+
+    /// Whether stack call `call` (0-based) runs the H module; the others run the L module.
+    pub fn isHigh(c: Config, call: usize) bool {
+        return call % (c.l_cycles + 1) == c.l_cycles;
+    }
+};
+
+fn object(v: std.json.Value) Error!std.json.ObjectMap {
+    return if (v == .object) v.object else error.BadHrmConfig;
+}
+
+fn number(v: std.json.Value) Error!f64 {
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        else => error.BadHrmConfig,
+    };
+}
+
+fn isString(v: ?std.json.Value, expected: []const u8) bool {
+    const s = v orelse return false;
+    return s == .string and std.mem.eql(u8, s.string, expected);
+}
+
+/// `key` is the JSON boolean `want`, or absent when `absent_ok`.
+fn isBool(o: std.json.ObjectMap, key: []const u8, want: bool, absent_ok: bool) bool {
+    const v = o.get(key) orelse return absent_ok;
+    return v == .bool and v.bool == want;
+}
+
+/// A positive dimension.
+fn size(o: std.json.ObjectMap, key: []const u8) Error!usize {
+    const v = o.get(key) orelse return error.BadHrmConfig;
+    if (v != .integer) return error.BadHrmConfig;
+    return if (v.integer > 0) @intCast(v.integer) else error.UnsupportedHrmGeometry;
+}
+
+/// The rope base: rope_parameters' (transformers 5), else rope_theta; only the default rope is taken.
+fn rope(o: std.json.ObjectMap) Error!f64 {
+    if (o.get("rope_scaling")) |r| if (r != .null) return error.UnsupportedHrmRotary;
+    if (o.get("rope_parameters")) |p| if (p != .null) {
+        const params = try object(p);
+        if (params.get("rope_type")) |t| if (!isString(t, "default")) return error.UnsupportedHrmRotary;
+        if (params.get("rope_theta")) |t| return number(t);
+    };
+    return number(o.get("rope_theta") orelse return error.BadHrmConfig);
+}
+
+/// The embeddings' scale as transformers sets it: embedding_scale, else 1 / initializer_range.
+fn embedScale(o: std.json.ObjectMap) Error!f64 {
+    if (o.get("embedding_scale")) |s| if (s != .null) return number(s);
+    const range = try number(o.get("initializer_range") orelse return error.BadHrmConfig);
+    if (!(range > 0)) return error.BadHrmConfig;
+    return 1.0 / range;
+}
+
+/// A ModelOpt NVFP4 export (group 16, weights only): true; none: false; any other scheme refused.
+fn modeloptNvfp4(q: std.json.Value) Error!bool {
+    if (q == .null) return false;
+    const o = try object(q);
+    if (!isString(o.get("quant_method"), "modelopt")) return error.UnsupportedHrmPrecision;
+    if (!isString(o.get("quant_algo"), "NVFP4")) return error.UnsupportedHrmPrecision;
+    if (o.get("group_size")) |g| if (g != .integer or g.integer != 16) return error.UnsupportedHrmPrecision;
+    if (o.get("kv_cache_quant_algo")) |k| if (k != .null) return error.UnsupportedHrmPrecision;
+    return true;
+}
+
+pub fn parse(gpa: std.mem.Allocator, bytes: []const u8) Error!Config {
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+    defer parsed.deinit();
+    const root = try object(parsed.value);
+    if (!isString(root.get("model_type"), "hrm_text")) return error.BadHrmConfig;
+    // the released layer: SiLU SwiGLU, no biases, an untied head
+    if (!isString(root.get("hidden_act"), "silu")) return error.UnsupportedHrmGeometry;
+    for ([_][]const u8{ "attention_bias", "mlp_bias", "tie_word_embeddings" }) |key|
+        if (!isBool(root, key, false, true)) return error.UnsupportedHrmGeometry;
+    for ([_][]const u8{ "torch_dtype", "dtype" }) |key| if (root.get(key)) |d| if (!isString(d, "bfloat16")) return error.UnsupportedHrmPrecision;
+    const heads = try size(root, "num_attention_heads");
+    // multi-head attention: HrmTextAttention projects k and v to num_attention_heads (num_key_value_heads unused)
+    if (root.get("num_key_value_heads")) |kv| if (kv != .integer or kv.integer != heads) return error.UnsupportedHrmGeometry;
+    // a config saved after transformers' post-init names both; a raw export names the per-stack count only
+    const per_stack = if (root.get("num_layers_per_stack")) |v| (if (v == .integer and v.integer > 0) @as(usize, @intCast(v.integer)) else return error.BadHrmConfig) else try size(root, "num_hidden_layers");
+    var c: Config = .{
+        .hidden = try size(root, "hidden_size"),
+        .intermediate = try size(root, "intermediate_size"),
+        .per_stack = per_stack,
+        .h_cycles = try size(root, "H_cycles"),
+        .l_cycles = try size(root, "L_cycles"),
+        .heads = heads,
+        .vocab = try size(root, "vocab_size"),
+        .eps = @floatCast(try number(root.get("rms_norm_eps") orelse return error.BadHrmConfig)),
+        .theta = try rope(root),
+        .embed_scale = @floatCast(try embedScale(root)),
+        .context = try size(root, "max_position_embeddings"),
+        .prefix_lm = isBool(root, "prefix_lm", true, false),
+    };
+    if (root.get("num_layers_per_stack") != null) {
+        // post-init's num_hidden_layers is the slot count; a disagreeing pair is not this layout
+        if ((try size(root, "num_hidden_layers")) != c.slots()) return error.BadHrmConfig;
+    }
+    if (try size(root, "head_dim") != head_dim) return error.UnsupportedHrmGeometry;
+    if (c.calls() > max_calls or c.per_stack > max_per_stack) return error.UnsupportedHrmGeometry;
+    // the lane matmul steps k by 64s, the row kernels a 64-value vector
+    if (c.hidden % 64 != 0 or c.intermediate % 64 != 0 or c.width() != c.hidden) return error.UnsupportedHrmGeometry;
+    if (!(c.eps > 0) or !(c.theta > 0) or !(c.embed_scale > 0)) return error.BadHrmConfig;
+    if (c.prefix_lm and c.context > max_context) return error.HrmPastPromptRows;
+    if (root.get("quantization_config")) |q| c.nvfp4 = try modeloptNvfp4(q);
+    return c;
+}
+
+const fixture = @embedFile("fixtures/config.json");
+
+test "DFM-Mimir-v1.8's config: two 16-layer stacks, 2 x (3 + 1) calls, 128 layer slots, PrefixLM" {
+    const c = try parse(std.testing.allocator, fixture);
+    try std.testing.expectEqual(@as(usize, 1536), c.hidden);
+    try std.testing.expectEqual(@as(usize, 4096), c.intermediate);
+    try std.testing.expectEqual(@as(usize, 16), c.per_stack);
+    try std.testing.expectEqual(@as(usize, 8), c.calls());
+    try std.testing.expectEqual(@as(usize, 128), c.slots());
+    try std.testing.expectEqual(@as(usize, 12), c.heads);
+    try std.testing.expectEqual(@as(usize, 262144), c.vocab);
+    try std.testing.expectEqual(@as(f64, 10000), c.theta);
+    try std.testing.expectEqual(@as(f32, @floatCast(39.191835884530846)), c.embed_scale);
+    try std.testing.expectEqual(@as(usize, 4096), c.context);
+    try std.testing.expect(c.prefix_lm and !c.nvfp4);
+    // calls 0, 1, 2 and 4, 5, 6 run L; 3 and 7 run H
+    for (0..8) |call| try std.testing.expectEqual(call == 3 or call == 7, c.isHigh(call));
+}
+
+test "hrm_text config: transformers' post-init layout, an 8K window and a ModelOpt NVFP4 export are admitted" {
+    const gpa = std.testing.allocator;
+    const post = try std.mem.replaceOwned(u8, gpa, fixture, "\"num_hidden_layers\": 16,", "\"num_hidden_layers\": 128, \"num_layers_per_stack\": 16,");
+    defer gpa.free(post);
+    try std.testing.expectEqual(@as(usize, 128), (try parse(gpa, post)).slots());
+    const window = try std.mem.replaceOwned(u8, gpa, fixture, "\"max_position_embeddings\": 4096", "\"max_position_embeddings\": 8192");
+    defer gpa.free(window);
+    try std.testing.expectEqual(@as(usize, 8192), (try parse(gpa, window)).context);
+    const q = try std.mem.replaceOwned(u8, gpa, fixture, "\"prefix_lm\": true,", "\"prefix_lm\": true, \"quantization_config\": {\"quant_method\": \"modelopt\", \"quant_algo\": \"NVFP4\", \"group_size\": 16, \"kv_cache_quant_algo\": null},");
+    defer gpa.free(q);
+    try std.testing.expect((try parse(gpa, q)).nvfp4);
+}
+
+test "hrm_text config: another geometry, rope, scheme or a window past the prompt chunk is refused" {
+    const gpa = std.testing.allocator;
+    const refused = .{
+        .{ "\"model_type\": \"hrm_text\"", "\"model_type\": \"llama\"", error.BadHrmConfig },
+        .{ "\"head_dim\": 128", "\"head_dim\": 64", error.UnsupportedHrmGeometry },
+        .{ "\"num_key_value_heads\": 12", "\"num_key_value_heads\": 4", error.UnsupportedHrmGeometry },
+        .{ "\"hidden_act\": \"silu\"", "\"hidden_act\": \"gelu\"", error.UnsupportedHrmGeometry },
+        .{ "\"tie_word_embeddings\": false", "\"tie_word_embeddings\": true", error.UnsupportedHrmGeometry },
+        .{ "\"rope_type\": \"default\"", "\"rope_type\": \"yarn\"", error.UnsupportedHrmRotary },
+        .{ "\"max_position_embeddings\": 4096", "\"max_position_embeddings\": 16384", error.HrmPastPromptRows },
+        .{ "\"H_cycles\": 2", "\"H_cycles\": 5", error.UnsupportedHrmGeometry },
+        .{ "\"prefix_lm\": true,", "\"prefix_lm\": true, \"quantization_config\": {\"quant_method\": \"modelopt\", \"quant_algo\": \"FP8\"},", error.UnsupportedHrmPrecision },
+    };
+    inline for (refused) |k| {
+        const bytes = try std.mem.replaceOwned(u8, gpa, fixture, k[0], k[1]);
+        defer gpa.free(bytes);
+        try std.testing.expect(!std.mem.eql(u8, bytes, fixture));
+        try std.testing.expectError(k[2], parse(gpa, bytes));
+    }
+}
